{% block element_faq_harmonica %}
    {% if element.config.uctIntroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'intro' } %}
    {% endif %}
    {% set faqs = element.config.faqs.value %}
    {% set theme = element.config.theme.value|default('clean') %}
    {% set accordionId = 'faqAccordion-' ~ element.id %}

    <div class="cms-element-faq-harmonica uct-accordion theme-{{ theme }}">
        {% if faqs and faqs|length > 0 %}
            <div class="accordion" id="{{ accordionId }}">
                {% for faq in faqs %}
                    {% set collapseId = accordionId ~ '-collapse-' ~ loop.index %}
                    {% set headingId = accordionId ~ '-heading-' ~ loop.index %}
                    {% set itemNumber = (loop.index < 10 ? '0' ~ loop.index : loop.index) %}

                    <div class="accordion-item faq-harmonica-item uct-accordion-item">
                        <h3 class="accordion-header faq-harmonica-header uct-accordion-header" id="{{ headingId }}">
                            <button class="accordion-button faq-harmonica-button uct-accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#{{ collapseId }}" aria-expanded="false" aria-controls="{{ collapseId }}">
                                {% if theme == 'pill-block' %}
                                    <span class="faq-harmonica-pill-badge uct-accordion-pill-badge">
                                        {% sw_icon 'arrow-head-down' style { 'class': 'badge-icon icon-chevron' } %}
                                    </span>
                                {% endif %}

                                {% if theme == 'editorial-numbered' %}
                                    <span class="faq-harmonica-number uct-accordion-number">({{ itemNumber }})</span>
                                {% endif %}

                                {% include '@UltimateCmsTools/storefront/utilities/uct-accordion-icon.html.twig' with { item: faq } only %}

                                <span class="faq-harmonica-title uct-accordion-title">{{ faq.title }}</span>

                                {% if theme != 'pill-block' %}
                                    <span class="faq-harmonica-toggle-icon-wrapper uct-accordion-toggle-icon-wrapper">
                                        {% sw_icon 'arrow-head-down' style { 'class': 'faq-toggle-chevron' } %}
                                    </span>
                                {% endif %}
                            </button>
                        </h3>
                        <div id="{{ collapseId }}" class="accordion-collapse collapse" aria-labelledby="{{ headingId }}" data-bs-parent="#{{ accordionId }}">
                            <div class="accordion-body faq-harmonica-body uct-accordion-body">
                                {{ faq.content|sw_sanitize }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {% set faqEntities = [] %}
            {% for faq in faqs %}
                {% if faq.title|default('')|striptags|trim and faq.content|default('')|trim %}
                    {% set faqEntities = faqEntities|merge([{
                        '@type': 'Question',
                        'name': faq.title|striptags|trim,
                        'acceptedAnswer': {
                            '@type': 'Answer',
                            'text': faq.content|trim
                        }
                    }]) %}
                {% endif %}
            {% endfor %}

            {% if faqEntities|length > 0 %}
                {% set faqSchema = {
                    '@context': 'https://schema.org',
                    '@type': 'FAQPage',
                    'mainEntity': faqEntities
                } %}
                <script type="application/ld+json">
                    {{ faqSchema|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}
                </script>
            {% endif %}
        {% endif %}
    </div>
    {% if element.config.uctOutroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'outro' } %}
    {% endif %}
{% endblock %}
