{% sw_extends '@Storefront/storefront/component/product/card/box-standard.html.twig' %}

{% block component_product_box_variant_characteristics %}
    {{ parent() }}
    {% if showVariants and configurator|length %}
        <div class="product-detail-configurator uct-single-product-configurator">
            {% for group in configurator %}
                <div class="product-detail-configurator-group mb-3">
                    <label class="product-detail-configurator-group-title form-label" for="uct-{{ slotId }}-{{ group.id }}">{{ group.translated.name }}</label>
                    <select class="form-select product-detail-configurator-select-input" id="uct-{{ slotId }}-{{ group.id }}" data-single-product-option="{{ group.id }}">
                        {% for option in group.options %}
                            <option value="{{ option.id }}"{% if option.id in product.optionIds %} selected{% endif %}>{{ option.translated.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block component_product_box_action %}
    {% set uctSingleProduct = true %}
    {{ parent() }}
{% endblock %}
