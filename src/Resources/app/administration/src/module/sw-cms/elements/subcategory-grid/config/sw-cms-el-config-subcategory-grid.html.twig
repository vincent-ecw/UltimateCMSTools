<div class="sw-cms-el-config-subcategory-grid">
    <sw-tabs default-item="content">
        <template #default="{ active }">
            <sw-tabs-item name="content" :active-tab="active">{{ $t('sw-cms.elements.ultimateCmsTools.introOutro.content') }}</sw-tabs-item>
            <sw-tabs-item name="intro-outro" :active-tab="active">{{ $t('sw-cms.elements.ultimateCmsTools.introOutro.tab') }}</sw-tabs-item>
        </template>
        <template #content="{ active }">
            <div v-if="active === 'content'">
    <sw-alert variant="info">
        {{ $tc('sw-cms.elements.ultimateCmsTools.subcategoryGrid.configInfo') }}
    </sw-alert>

    <sw-single-select
        v-model:value="theme"
        :label="$tc('sw-cms.elements.ultimateCmsTools.subcategoryThemes.label')"
        :helpText="$tc('sw-cms.elements.ultimateCmsTools.subcategoryThemes.help')"
        :options="themeOptions">
    </sw-single-select>

    <sw-switch-field
        v-model:value="showAllSubcategories"
        :label="$tc('sw-cms.elements.ultimateCmsTools.subcategoryGrid.config.showAllSubcategoriesLabel')">
    </sw-switch-field>

    <sw-switch-field
        v-model:value="displayImage"
        :label="$tc('sw-cms.elements.ultimateCmsTools.subcategoryGrid.config.displayImageLabel')">
    </sw-switch-field>

    <sw-switch-field
        v-model:value="displayDescription"
        :label="$tc('sw-cms.elements.ultimateCmsTools.subcategoryGrid.config.displayDescriptionLabel')">
    </sw-switch-field>

    <sw-single-select
        v-model:value="columnsMobile"
        :label="$tc('sw-cms.elements.ultimateCmsTools.subcategoryGrid.config.columnsMobileLabel')"
        :options="columnsMobileOptions">
    </sw-single-select>

            </div>
            <div v-if="active === 'intro-outro'"><uct-cms-intro-outro v-model:intro="uctIntroText" v-model:outro="uctOutroText" /></div>
        </template>
    </sw-tabs>
</div>
