{% block element_flexible_image_text %}
    {% set config = element.fieldConfig.elements %}
    
    {% set position = config.position.value|default('image-left') %}
    {% set columnSize = config.columnSize.value|default('50-50') %}
    {% set animation = config.animation.value|default('none') %}
    {% set theme = config.theme.value|default('traditional') %}
    {% set content = config.content.value|default('') %}
    {% set readMoreText = config.readMoreText.value|default('')|sw_sanitize %}
    {% set hasReadMore = readMoreText|striptags|replace({'&nbsp;': '', '&#160;': '', ' ': ''})|trim != '' %}
    {% set readMoreMaxWidth = config.readMoreMaxWidth.value|default('')|uct_read_more_width %}
    {% set readMoreButtonStyle = config.readMoreButtonStyle.value|default('primary') %}
    {% set readMoreButtonStyle = readMoreButtonStyle in ['primary', 'secondary', 'outline-primary', 'outline-secondary', 'light', 'dark', 'link'] ? readMoreButtonStyle : 'primary' %}
    {% set caption = config.caption.value|default('') %}
    {% set media = element.data ? element.data.get('media') : null %}

    {% set elementClasses = 'cms-element-flexible-image-text theme-' ~ theme ~ ' position-' ~ position ~ ' col-' ~ columnSize %}
    {% if animation != 'none' %}
        {% set elementClasses = elementClasses ~ ' animation-' ~ animation %}
    {% endif %}


    <div class="{{ elementClasses }}"
         {% if animation != 'none' %}data-flexible-image-text-animation="{{ animation }}"{% endif %}>
        
        {% if theme == 'offset' %}
            <div class="flexible-image-text__offset-frame"></div>
        {% endif %}

        <div class="flexible-image-text__container">
            {# Image Column #}
            <div class="flexible-image-text__image-wrapper">
                {% if media %}
                    {% if theme == 'polaroid' %}
                        <div class="flexible-image-text__polaroid-card">
                            <div class="flexible-image-text__polaroid-image">
                                {% sw_thumbnails 'flexible-image-text-img' with {
                                    media: media,
                                    sizes: {
                                        'xs': '576px',
                                        'sm': '768px',
                                        'md': '992px',
                                        'lg': '1200px'
                                    },
                                    attributes: {
                                        'class': 'flexible-image-text__image',
                                        'alt': (media.translated.alt ?: caption ?: '')
                                    }
                                } %}
                            </div>
                            {% if caption %}
                                <div class="flexible-image-text__caption">
                                    {{ caption }}
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="flexible-image-text__media-box">
                            {% sw_thumbnails 'flexible-image-text-img' with {
                                media: media,
                                sizes: {
                                    'xs': '576px',
                                    'sm': '768px',
                                    'md': '992px',
                                    'lg': '1200px'
                                },
                                attributes: {
                                    'class': 'flexible-image-text__image',
                                    'alt': (media.translated.alt ?: caption ?: '')
                                }
                            } %}
                        </div>
                        {% if caption and theme != 'polaroid' %}
                            <div class="flexible-image-text__image-subcaption">
                                {{ caption }}
                            </div>
                        {% endif %}
                    {% endif %}
                {% endif %}
            </div>

            {# Text Column #}
            <div class="flexible-image-text__text-wrapper">
                <div class="flexible-image-text__text-content">
                    {% if content matches '/<[^>]+>/' %}
                        {{ content|sw_sanitize }}
                    {% else %}
                        <p>{{ content|nl2br }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
        {% if hasReadMore %}
            <div class="uct-read-more" data-uct-read-more{% if readMoreMaxWidth %} style="max-width: {{ readMoreMaxWidth }};"{% endif %}>
                <div id="uct-read-more-{{ element.id }}" class="uct-read-more__panel" data-uct-read-more-panel aria-hidden="true" inert>
                    <div class="uct-read-more__inner">
                        <div class="uct-read-more__content flexible-image-text__text-content">{{ readMoreText|raw }}</div>
                    </div>
                </div>
                <div class="uct-read-more__actions">
                    <button type="button" class="btn btn-{{ readMoreButtonStyle }} uct-read-more__toggle" hidden
                            aria-expanded="false" aria-controls="uct-read-more-{{ element.id }}"
                            data-uct-read-more-toggle
                            data-label-more="{{ 'ultimateCmsTools.flexibleImageText.readMore'|trans }}"
                            data-label-less="{{ 'ultimateCmsTools.flexibleImageText.readLess'|trans }}">
                        {{ 'ultimateCmsTools.flexibleImageText.readMore'|trans }}
                    </button>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
