{% block element_manufacturer_grid %}
    {% set descriptionLines = element.config.descriptionLines.value|default(3)|uct_bounded_int(1, 20, 3) %}
    {% if element.config.uctIntroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'intro' } %}
    {% endif %}
    {% set config = element.fieldConfig.elements %}
    {% set manufacturers = element.data.manufacturers %}
    {% set displayLogo = config.displayLogo.value is not null ? config.displayLogo.value : true %}
    {% set displayTitle = config.displayTitle.value is not null ? config.displayTitle.value : true %}
    {% set displayDescription = config.displayDescription.value is not null ? config.displayDescription.value : true %}
    {% set columnsMobile = config.columnsMobile.value ?? '1' %}

    {% set requestedTheme = config.theme.value|default('classic') %}
    {% set theme = requestedTheme in ['classic', 'badge', 'basic', 'playful', 'modern'] ? requestedTheme : 'classic' %}

    {% if manufacturers and manufacturers.count > 0 %}
        <div class="cms-element-manufacturer-grid manufacturer-theme-{{ theme }}" style="--uct-description-lines: {{ descriptionLines }};">
            <div class="manufacturer-grid-container columns-mobile-{{ columnsMobile }}">
                {% for manufacturer in manufacturers %}
                    {% set manufacturerUrl = manufacturer.link|uct_safe_url %}
                    {% set extStruct = manufacturer.extension('ultimateCmsTools') %}
                    {% set isExternal = extStruct ? extStruct.isExternal : false %}
                    {% set media = manufacturer.media %}
                    
                    {% if manufacturerUrl %}
                        <a href="{{ manufacturerUrl }}" class="manufacturer-card manufacturer-card--{{ theme }}" title="{{ manufacturer.translated.name }}" {% if isExternal %}target="_blank" rel="noopener noreferrer"{% else %}target="_self"{% endif %}>
                            {% if displayLogo and theme != 'badge' %}
                                <div class="manufacturer-card-image-wrapper">
                                    {% if media %}
                                        {% set attributes = {
                                            'class': 'manufacturer-card-logo',
                                            'alt': (media.translated.alt ?: manufacturer.translated.name),
                                            'title': (media.translated.title ?: manufacturer.translated.name),
                                            'loading': 'lazy'
                                        } %}
                                        {% sw_thumbnails 'manufacturer-card-thumbnails' with {
                                            uctImageProfile: theme == 'playful' ? 'logo-playful' : 'logo',
                                            media: media,
                                            sizes: {default: '(min-width: 992px) 25vw, (min-width: 768px) 33.34vw, (min-width: 576px) 50vw, 100vw'},
                                            attributes: attributes
                                        } %}
                                    {% else %}
                                        <div class="manufacturer-card-image-placeholder">
                                            <span class="manufacturer-card-placeholder-text">{{ manufacturer.translated.name }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if displayTitle or theme == 'badge' or (displayDescription and theme in ['classic', 'basic']) %}
                                <div class="manufacturer-card-content">
                                    {% if displayTitle or theme == 'badge' %}
                                        <h3 class="manufacturer-card-title">{{ manufacturer.translated.name }}</h3>
                                    {% endif %}
                                    {% if displayDescription and theme in ['classic', 'basic'] %}
                                        <div class="manufacturer-card-description">
                                            {{ manufacturer.translated.description|striptags }}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </a>
                    {% else %}
                        <div class="manufacturer-card manufacturer-card--{{ theme }}" title="{{ manufacturer.translated.name }}">
                            {% if displayLogo and theme != 'badge' %}
                                <div class="manufacturer-card-image-wrapper">
                                    {% if media %}
                                        {% set attributes = {
                                            'class': 'manufacturer-card-logo',
                                            'alt': (media.translated.alt ?: manufacturer.translated.name),
                                            'title': (media.translated.title ?: manufacturer.translated.name),
                                            'loading': 'lazy'
                                        } %}
                                        {% sw_thumbnails 'manufacturer-card-thumbnails' with {
                                            uctImageProfile: theme == 'playful' ? 'logo-playful' : 'logo',
                                            media: media,
                                            sizes: {default: '(min-width: 992px) 25vw, (min-width: 768px) 33.34vw, (min-width: 576px) 50vw, 100vw'},
                                            attributes: attributes
                                        } %}
                                    {% else %}
                                        <div class="manufacturer-card-image-placeholder">
                                            <span class="manufacturer-card-placeholder-text">{{ manufacturer.translated.name }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if displayTitle or theme == 'badge' or (displayDescription and theme in ['classic', 'basic']) %}
                                <div class="manufacturer-card-content">
                                    {% if displayTitle or theme == 'badge' %}
                                        <h3 class="manufacturer-card-title">{{ manufacturer.translated.name }}</h3>
                                    {% endif %}
                                    {% if displayDescription and theme in ['classic', 'basic'] %}
                                        <div class="manufacturer-card-description">
                                            {{ manufacturer.translated.description|striptags }}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endif %}
    {% if element.config.uctOutroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'outro' } %}
    {% endif %}
{% endblock %}
