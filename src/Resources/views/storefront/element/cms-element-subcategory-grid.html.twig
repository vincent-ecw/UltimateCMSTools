{% block element_subcategory_grid %}
    {% set descriptionLines = element.config.descriptionLines.value|default(3)|uct_bounded_int(1, 20, 3) %}
    {% if element.config.uctIntroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'intro' } %}
    {% endif %}
    {% set categories = element.data.categories %}
    {% set displayImage = element.config.displayImage.value ?? true %}
    {% set displayDescription = element.config.displayDescription.value ?? true %}
    {% set columnsMobile = element.config.columnsMobile.value ?? '1' %}

    {% set requestedTheme = element.config.theme.value|default('classic') %}
    {% set theme = requestedTheme in ['classic', 'badge', 'basic', 'playful', 'modern'] ? requestedTheme : 'classic' %}

    {% if categories and categories.count > 0 %}
        <div class="cms-element-subcategory-grid subcategory-theme-{{ theme }}" style="--uct-description-lines: {{ descriptionLines }};">
            <div class="subcategory-grid-container columns-mobile-{{ columnsMobile }}">
                {% for category in categories %}
                    {% set categoryUrl = seoUrl('frontend.navigation.page', { navigationId: category.id }) %}
                    {% set media = category.media %}
                    
                    <a href="{{ categoryUrl }}" class="subcategory-card subcategory-card--{{ theme }}" title="{{ category.translated.name }}">
                        {% if displayImage and theme != 'badge' %}
                            <div class="subcategory-card-image-wrapper">
                                {% if media %}
                                    {% set attributes = {
                                        'class': 'subcategory-card-image',
                                        'alt': (media.translated.alt ?: category.translated.name),
                                        'title': (media.translated.title ?: category.translated.name),
                                        'loading': 'lazy'
                                    } %}
                                    {% sw_thumbnails 'subcategory-card-thumbnails' with {
                                        uctImageProfile: theme == 'playful' ? 'card-playful' : (theme == 'modern' ? 'card-modern' : 'card'),
                                        media: media,
                                        sizes: {default: '(min-width: 992px) 25vw, (min-width: 768px) 33.34vw, (min-width: 576px) 50vw, 100vw'},
                                        attributes: attributes
                                    } %}
                                {% else %}
                                    <div class="subcategory-card-image-placeholder">
                                        {% sw_icon 'image' style { 'size': 'lg' } %}
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}

                        <div class="subcategory-card-content">
                            <h3 class="subcategory-card-title">{{ category.translated.name }}</h3>
                            {% if displayDescription and theme in ['classic', 'basic'] %}
                                <div class="subcategory-card-description">
                                    {{ category.translated.description|striptags }}
                                </div>
                            {% endif %}
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
    {% if element.config.uctOutroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'outro' } %}
    {% endif %}
{% endblock %}
