{% block element_custom_code %}
    {% if element.config.uctIntroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'intro' } %}
    {% endif %}
    <div class="cms-element-custom-code">
        {% if element.config.cssCode.value %}
            <style>
                {{ element.config.cssCode.value|raw }}
            </style>
        {% endif %}

        {% if element.config.jsCode.value %}
            <script>
                {{ element.config.jsCode.value|raw }}
            </script>
        {% endif %}
    </div>
    {% if element.config.uctOutroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'outro' } %}
    {% endif %}
{% endblock %}
