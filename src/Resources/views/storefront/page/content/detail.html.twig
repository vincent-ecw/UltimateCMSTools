{% sw_extends '@Storefront/storefront/page/content/detail.html.twig' %}

{% block page_content_section %}
    {% set targetCustomerGroupId = section.customFields.uct_customer_group_id|default(null) %}
    {% set loginStatus = section.customFields.uct_login_status|default(targetCustomerGroupId ? 'logged-in' : 'all') %}
    {% set isLoggedIn = context.customer and not context.customer.guest %}
    {% set matchesLoginStatus = loginStatus == 'all' or (loginStatus == 'logged-in' and isLoggedIn) or (loginStatus == 'logged-out' and not isLoggedIn) %}
    {% set matchesCustomerGroup = loginStatus != 'logged-in' or not targetCustomerGroupId or (isLoggedIn and targetCustomerGroupId == context.customer.groupId) %}

    {% if matchesLoginStatus and matchesCustomerGroup %}
        {% set hideWhenEmpty = section.customFields.uct_hide_empty|default(false) %}
        {% if hideWhenEmpty %}
            {% set safeSectionBgColor = sectionBgColor|uct_css_color %}
            {% set safeSectionBgImg = sectionBgImg|uct_css_url %}
            {% set safeSectionBgImgMode = section.backgroundMediaMode in ['cover', 'contain', 'auto'] ? section.backgroundMediaMode : 'cover' %}
            {% set sectionContent %}
                {% sw_include '@Storefront/storefront/section/cms-section-' ~ section.type ~ '.html.twig' %}
            {% endset %}

            {# Check if sectionContent has visible/meaningful content #}
            {% if sectionContent|striptags|trim is not empty or '<img' in sectionContent or '<svg' in sectionContent or '<iframe' in sectionContent or '<video' in sectionContent or '<canvas' in sectionContent or '<input' in sectionContent or '<button' in sectionContent or '<a' in sectionContent %}
                <div class="cms-section {{ sectionClasses|join(' ') }}"
                     style="{% if safeSectionBgColor %}background-color: {{ safeSectionBgColor }};{% endif %}{% if safeSectionBgImg %}background-image: url('{{ safeSectionBgImg }}');background-size: {{ safeSectionBgImgMode }};{% endif %}">
                    {{ sectionContent|raw }}
                </div>
            {% endif %}
        {% else %}
            {{ parent() }}
        {% endif %}
    {% endif %}
{% endblock %}
