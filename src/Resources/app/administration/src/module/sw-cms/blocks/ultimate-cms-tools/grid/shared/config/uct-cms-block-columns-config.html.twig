<div class="uct-cms-block-columns-config">
    <!-- Quick prompt / guidance -->
    <div v-if="columnCount > 1" class="uct-columns-prompt">
        <span class="uct-columns-prompt-text">{{ $t('sw-cms.columnConfig.clickToSelectPrompt') }}</span>
    </div>

    <!-- Prominent Segmented Column Selector -->
    <div v-if="columnCount > 1" class="uct-columns-selector-wrapper">
        <label class="uct-columns-selector-label">{{ $t('sw-cms.columnConfig.columnSelectLabel') }}</label>
        <div class="uct-columns-tabs">
            <button
                v-for="col in columns"
                :key="col.id"
                type="button"
                class="uct-column-tab-btn"
                :class="{ 'is--active': activeColumn === col.id }"
                @click="activeColumn = col.id"
            >
                {{ col.label }}
            </button>
        </div>
    </div>

    <div class="uct-column-settings-form">
        <!-- Inner Padding -->
        <mt-text-field
            v-model="colPadding"
            :label="$t('sw-cms.columnConfig.paddingLabel')"
            :placeholder="$t('sw-cms.columnConfig.paddingPlaceholder')"
            class="uct-config-field"
        />

        <!-- Background Color -->
        <mt-colorpicker
            v-model="colBgColor"
            :label="$t('sw-cms.columnConfig.bgColorLabel')"
            class="uct-config-field"
        />

        <!-- Background Image -->
        <sw-media-compact-upload-v2
            :source="colMedia"
            :upload-tag="'uct-col-bg-' + activeColumn"
            :label="$t('sw-cms.columnConfig.bgImageLabel')"
            :default-folder="cmsPageState.pageEntityName || 'cms_page'"
            :allow-multi-select="false"
            class="uct-config-field"
            @media-upload-remove-image="onRemoveMedia"
            @selection-change="onSelectMedia"
        />
        <sw-upload-listener
            :upload-tag="'uct-col-bg-' + activeColumn"
            auto-upload
            @media-upload-finish="onUploadMediaFinish"
        />

        <!-- Background Image Mode -->
        <mt-select
            v-if="hasBackgroundImage"
            v-model="colBgMode"
            :label="$t('sw-cms.columnConfig.bgModeLabel')"
            :options="bgModeOptions"
            class="uct-config-field"
        />

        <!-- Custom CSS Class -->
        <mt-text-field
            v-model="colCssClass"
            :label="$t('sw-cms.columnConfig.cssClassLabel')"
            :placeholder="$t('sw-cms.columnConfig.cssClassPlaceholder')"
            class="uct-config-field"
        />
    </div>
</div>
