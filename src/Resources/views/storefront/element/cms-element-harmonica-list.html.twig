{% block element_harmonica_list %}
    {% if element.config.uctIntroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'intro' } %}
    {% endif %}
    {% set items = element.config.items.value|default(element.config.faqs.value) %}
    {% set theme = element.config.theme.value|default('clean') %}
    {% set accordionId = 'harmonicaAccordion-' ~ element.id %}

    <div class="cms-element-harmonica-list uct-accordion theme-{{ theme }}">
        {% if items and items|length > 0 %}
            <div class="accordion" id="{{ accordionId }}">
                {% for item in items %}
                    {% set collapseId = accordionId ~ '-collapse-' ~ loop.index %}
                    {% set headingId = accordionId ~ '-heading-' ~ loop.index %}
                    {% set itemNumber = (loop.index < 10 ? '0' ~ loop.index : loop.index) %}

                    <div class="accordion-item harmonica-list-item uct-accordion-item">
                        <h3 class="accordion-header harmonica-list-header uct-accordion-header" id="{{ headingId }}">
                            <button class="accordion-button harmonica-list-button uct-accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#{{ collapseId }}" aria-expanded="false" aria-controls="{{ collapseId }}">
                                {% if theme == 'pill-block' %}
                                    <span class="harmonica-list-pill-badge uct-accordion-pill-badge">
                                        {% sw_icon 'arrow-head-down' style { 'class': 'badge-icon icon-chevron' } %}
                                    </span>
                                {% endif %}

                                {% if theme == 'editorial-numbered' %}
                                    <span class="harmonica-list-number uct-accordion-number">({{ itemNumber }})</span>
                                {% endif %}

                                {% include '@UltimateCmsTools/storefront/utilities/uct-accordion-icon.html.twig' with { item: item } only %}

                                <span class="harmonica-list-title uct-accordion-title">{{ item.title }}</span>

                                {% if theme != 'pill-block' %}
                                    <span class="harmonica-list-toggle-icon-wrapper uct-accordion-toggle-icon-wrapper">
                                        {% sw_icon 'arrow-head-down' style { 'class': 'harmonica-toggle-chevron' } %}
                                    </span>
                                {% endif %}
                            </button>
                        </h3>
                        <div id="{{ collapseId }}" class="accordion-collapse collapse" aria-labelledby="{{ headingId }}" data-bs-parent="#{{ accordionId }}">
                            <div class="accordion-body harmonica-list-body uct-accordion-body">
                                {{ item.content|sw_sanitize }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    {% if element.config.uctOutroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'outro' } %}
    {% endif %}
{% endblock %}
