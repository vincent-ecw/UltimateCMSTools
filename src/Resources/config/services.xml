<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="VincentBourgonje\UltimateCmsTools\Core\ManufacturerCustomFields">
            <argument type="service" id="custom_field_set.repository" />
            <argument type="service" id="custom_field.repository" />
        </service>
        <service id="VincentBourgonje\UltimateCmsTools\Subscriber\ManufacturerCustomFieldsSubscriber">
            <argument type="service" id="VincentBourgonje\UltimateCmsTools\Core\ManufacturerCustomFields" />
            <tag name="kernel.event_subscriber" />
        </service>
        <!-- ProductDetailRoute depends on the CMS resolver registry; defer it to avoid a construction cycle. -->
        <service id="VincentBourgonje\UltimateCmsTools\Core\SingleProductLoader" lazy="true">
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\Detail\ProductDetailRoute" />
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\FindVariant\FindProductVariantRoute" />
        </service>
        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\SingleProductCmsElementResolver">
            <argument type="service" id="VincentBourgonje\UltimateCmsTools\Core\SingleProductLoader" />
            <tag name="shopware.cms.data_resolver" />
        </service>
        <service id="VincentBourgonje\UltimateCmsTools\Controller\SingleProductController" public="true">
            <argument type="service" id="VincentBourgonje\UltimateCmsTools\Core\SingleProductLoader" />
            <call method="setContainer"><argument type="service" id="service_container" /></call>
            <tag name="controller.service_arguments" />
        </service>
        <service id="VincentBourgonje\UltimateCmsTools\Twig\CmsSecurityExtension">
            <tag name="twig.extension" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\CustomCodeCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\SubcategoryCarouselCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\SubcategoryGridCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\ManufacturerCarouselCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\ManufacturerGridCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\CommonSliderCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\CustomCarouselCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\CustomProductCarouselCmsElementResolver">
            <argument type="service" id="sales_channel.product.repository" />
            <argument type="service" id="Shopware\Core\Content\ProductStream\Service\ProductStreamBuilder" />
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\RelatedProductsCmsElementResolver">
            <argument type="service" id="Shopware\Core\Content\Product\SalesChannel\CrossSelling\ProductCrossSellingRoute" />
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\ResponsiveImageCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\MagazineQuoteCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\CtaCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\ImageTextQuartetCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\CategoryHeaderCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\DataResolver\FlexibleImageTextCmsElementResolver">
            <tag name="shopware.cms.data_resolver" />
        </service>

        <service id="VincentBourgonje\UltimateCmsTools\Subscriber\HttpCacheSubscriber">
            <tag name="kernel.event_subscriber" />
        </service>
    </services>

</container>
