<div class="sw-cms-el-config-manufacturer-grid">
    <sw-tabs default-item="content">
        <template #default="{ active }">
            <sw-tabs-item name="content" :active-tab="active">{{ $t('sw-cms.elements.ultimateCmsTools.introOutro.content') }}</sw-tabs-item>
            <sw-tabs-item name="intro-outro" :active-tab="active">{{ $t('sw-cms.elements.ultimateCmsTools.introOutro.tab') }}</sw-tabs-item>
        </template>
        <template #content="{ active }">
            <div v-if="active === 'content'">
    <sw-alert variant="info">
        {{ $tc('sw-cms.elements.ultimateCmsTools.manufacturerGrid.configInfo') }}
    </sw-alert>
    <div class="sw-cms-el-config-manufacturer-grid__settings" style="margin-top: 15px;">
        <sw-single-select
            v-model:value="sortBy"
            :label="$tc('sw-cms.elements.ultimateCmsTools.manufacturerSorting.sortBy')"
            :options="sortByOptions">
        </sw-single-select>

        <sw-single-select
            v-model:value="sorting"
            :label="$tc('sw-cms.elements.ultimateCmsTools.manufacturerSorting.label')"
            :helpText="$tc('sw-cms.elements.ultimateCmsTools.manufacturerSorting.help')"
            :options="sortingOptions">
        </sw-single-select>

        <sw-switch-field
            v-model:value="displayLogo"
            :label="$tc('sw-cms.elements.ultimateCmsTools.manufacturerGrid.config.displayLogoLabel')">
        </sw-switch-field>

        <sw-switch-field
            v-model:value="displayTitle"
            :label="$tc('sw-cms.elements.ultimateCmsTools.manufacturerGrid.config.displayTitleLabel')">
        </sw-switch-field>

        <sw-switch-field
            v-model:value="displayDescription"
            :label="$tc('sw-cms.elements.ultimateCmsTools.manufacturerGrid.config.displayDescriptionLabel')">
        </sw-switch-field>

        <sw-single-select
            v-model:value="columnsMobile"
            :label="$tc('sw-cms.elements.ultimateCmsTools.manufacturerGrid.config.columnsMobileLabel')"
            :options="columnsMobileOptions">
        </sw-single-select>
    </div>

            </div>
            <div v-if="active === 'intro-outro'"><uct-cms-intro-outro v-model:intro="uctIntroText" v-model:outro="uctOutroText" /></div>
        </template>
    </sw-tabs>
</div>
