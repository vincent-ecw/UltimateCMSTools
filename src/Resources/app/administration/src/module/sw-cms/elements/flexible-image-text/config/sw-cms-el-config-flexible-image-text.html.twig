<div class="sw-cms-el-config-flexible-image-text">
    <sw-tabs default-item="content" position="top">
        <template #default="{ active }">
            <sw-tabs-item name="content" :active-tab="active" @click="activeTab = 'content'">
                {{ $tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.tabs.content') }}
            </sw-tabs-item>
            <sw-tabs-item name="intro-outro" :active-tab="active" @click="activeTab = 'intro-outro'">
                {{ $t('sw-cms.elements.ultimateCmsTools.introOutro.tab') }}
            </sw-tabs-item>
            <sw-tabs-item name="settings" :active-tab="active" @click="activeTab = 'settings'">
                {{ $tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.tabs.settings') }}
            </sw-tabs-item>
        </template>
    </sw-tabs>
    <div v-if="activeTab === 'intro-outro'"><uct-cms-intro-outro v-model:intro="uctIntroText" v-model:outro="uctOutroText" /></div>

    <div v-if="activeTab === 'content'" class="sw-cms-el-config-flexible-image-text__content-tab">
        <!-- Media Upload -->
        <div class="sw-cms-el-config-flexible-image-text__media-upload">
            <sw-media-compact-upload-v2
                :source="media"
                :upload-tag="'flexible-image-text-media-' + element.id"
                :allowMultiSelect="false"
                :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.mediaLabel')"
                @selection-change="onImageSelect"
                @media-upload-remove-image="onImageRemove">
            </sw-media-compact-upload-v2>
            <sw-upload-listener
                :upload-tag="'flexible-image-text-media-' + element.id"
                auto-upload
                @media-upload-finish="onImageUpload">
            </sw-upload-listener>
        </div>

        <fieldset class="sw-cms-el-config-flexible-image-text__image-link">
            <legend>{{ $tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.imageLinkLabel') }}</legend>
            <sw-dynamic-url-field v-model:value="imageLink" />
            <mt-switch v-model:model-value="imageLinkNewTab"
                :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.imageLinkNewTab')"
                :help-text="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.imageLinkTargetHelp')" />
        </fieldset>
        <sw-text-field v-if="imageLink" v-model="imageLinkLabel"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.imageLinkAccessibleLabel')"
            :help-text="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.imageLinkAccessibleHelp')" />

        <!-- Polaroid / Image Caption -->
        <sw-text-field
            v-model="caption"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.captionLabel')"
            :placeholder="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.captionPlaceholder')"
            :help-text="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.captionHelp')">
        </sw-text-field>

        <!-- Rich Text Editor for Content -->
        <sw-text-editor
            :value="content"
            @update:value="onContentChange"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.contentLabel')"
            :placeholder="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.contentPlaceholder')">
        </sw-text-editor>
        <sw-text-editor
            :value="readMoreText"
            @update:value="readMoreText = $event"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.readMoreTextLabel')">
        </sw-text-editor>
    </div>

    <div v-if="activeTab === 'settings'" class="sw-cms-el-config-flexible-image-text__settings-tab">
        <sw-text-field
            v-model="readMoreMaxWidth"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.readMoreMaxWidthLabel')"
            :help-text="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.readMoreMaxWidthHelp')"
            placeholder="800px / 80%">
        </sw-text-field>

        <sw-single-select
            v-model:value="readMoreButtonStyle"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.readMoreButtonStyleLabel')"
            :options="readMoreButtonStyleOptions">
        </sw-single-select>

        <!-- Position -->
        <sw-single-select
            v-model:value="position"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.positionLabel')"
            :options="positionOptions">
        </sw-single-select>

        <!-- Column Size -->
        <sw-single-select
            v-model:value="columnSize"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.columnSizeLabel')"
            :options="columnSizeOptions">
        </sw-single-select>

        <!-- Entrance Animation -->
        <sw-single-select
            v-model:value="animation"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.animationLabel')"
            :options="animationOptions">
        </sw-single-select>

        <!-- Theme -->
        <sw-single-select
            v-model:value="theme"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.themeLabel')"
            :options="themeOptions">
        </sw-single-select>
    </div>
</div>
