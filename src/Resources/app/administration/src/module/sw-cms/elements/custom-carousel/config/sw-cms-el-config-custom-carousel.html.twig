<div class="sw-cms-el-config-custom-carousel">
    <sw-tabs class="sw-cms-el-config-custom-carousel__tabs" defaultItem="content">
        <template #default="{ active }">
            <sw-tabs-item name="content" :activeTab="active">
                {{ $tc('sw-cms.elements.customCarousel.config.tabs.content') }}
            </sw-tabs-item>
            <sw-tabs-item name="settings" :activeTab="active">
                {{ $tc('sw-cms.elements.customCarousel.config.tabs.settings') }}
            </sw-tabs-item>
        </template>

        <template #content="{ active }">
            <div v-if="active === 'content'" class="sw-cms-el-config-custom-carousel__tab-content">
                <div class="sw-cms-el-config-custom-carousel__items">
                    <div v-for="(item, index) in carouselItems" :key="item.id || index" class="sw-cms-el-config-custom-carousel__item">
                        <div class="sw-cms-el-config-custom-carousel__item-header">
                            <span class="item-number">Item {{ index + 1 }}</span>
                            <sw-button @click="onRemoveItem(index)" size="small" variant="danger">
                                {{ $tc('global.default.delete') }}
                            </sw-button>
                        </div>
                        
                        <div class="sw-cms-el-config-custom-carousel__item-content">
                            <sw-text-field 
                                v-model="item.title"
                                required
                                :label="$tc('sw-cms.elements.customCarousel.config.titleLabel')" 
                                :placeholder="$tc('sw-cms.elements.customCarousel.config.titlePlaceholder')">
                            </sw-text-field>

                            <sw-textarea-field
                                v-model="item.description"
                                :label="$tc('sw-cms.elements.customCarousel.config.descriptionLabel')" 
                                :placeholder="$tc('sw-cms.elements.customCarousel.config.descriptionPlaceholder')">
                            </sw-textarea-field>

                            <sw-media-compact-upload-v2
                                :source="item.mediaId"
                                :upload-tag="'custom-carousel-media-upload-' + element.id + '-' + index"
                                :allowMultiSelect="false"
                                :label="$tc('sw-cms.elements.customCarousel.config.mediaLabel')"
                                @selection-change="onImageSelect(item, $event)"
                                @media-upload-remove-image="onImageRemove(item)">
                            </sw-media-compact-upload-v2>

                            <sw-upload-listener
                                :upload-tag="'custom-carousel-media-upload-' + element.id + '-' + index"
                                auto-upload
                                @media-upload-finish="onImageUpload(item, $event)">
                            </sw-upload-listener>

                            <div class="sw-cms-el-config-custom-carousel__button-row">
                                <sw-text-field 
                                    v-model="item.buttonUrl"
                                    :label="$tc('sw-cms.elements.customCarousel.config.buttonUrlLabel')" 
                                    :placeholder="$tc('sw-cms.elements.customCarousel.config.buttonUrlPlaceholder')">
                                </sw-text-field>

                                <sw-single-select
                                    v-model="item.buttonTarget"
                                    :label="$tc('sw-cms.elements.customCarousel.config.buttonTargetLabel')"
                                    :options="[
                                        { value: '_self', label: $tc('sw-cms.elements.customCarousel.config.targetSelf') },
                                        { value: '_blank', label: $tc('sw-cms.elements.customCarousel.config.targetBlank') }
                                    ]">
                                </sw-single-select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="sw-cms-el-config-custom-carousel__actions">
                    <sw-button @click="onAddItem" variant="ghost" class="sw-cms-el-config-custom-carousel__add-button">
                        {{ $tc('sw-cms.elements.customCarousel.config.addButton') }}
                    </sw-button>
                </div>
            </div>

            <div v-if="active === 'settings'" class="sw-cms-el-config-custom-carousel__tab-settings">
                <sw-switch-field
                    v-model:value="element.config.navigationArrows.value"
                    :label="$tc('sw-cms.elements.customCarousel.config.navigationArrows')">
                </sw-switch-field>

                <sw-switch-field
                    v-model:value="element.config.navigationDots.value"
                    :label="$tc('sw-cms.elements.customCarousel.config.navigationDots')">
                </sw-switch-field>

                <sw-single-select
                    v-if="element.config.navigationDots.value"
                    v-model:value="element.config.navigationDotsPosition.value"
                    :label="$tc('sw-cms.elements.customCarousel.config.navigationDotsPosition')"
                    :options="dotsPositionOptions">
                </sw-single-select>

                <sw-switch-field
                    v-model:value="element.config.autoplay.value"
                    :label="$tc('sw-cms.elements.customCarousel.config.autoplay')">
                </sw-switch-field>

                <sw-number-field
                    v-if="element.config.autoplay.value"
                    v-model:value="element.config.autoplaySpeed.value"
                    :label="$tc('sw-cms.elements.customCarousel.config.autoplaySpeed')"
                    :helpText="$tc('sw-cms.elements.customCarousel.config.autoplaySpeedHelp')"
                    :min="0">
                </sw-number-field>

                <sw-number-field
                    v-model:value="element.config.maxHeight.value"
                    :label="$tc('sw-cms.elements.customCarousel.config.maxHeight')"
                    :helpText="$tc('sw-cms.elements.customCarousel.config.maxHeightHelp')"
                    :min="0">
                </sw-number-field>
            </div>
        </template>
    </sw-tabs>
</div>
