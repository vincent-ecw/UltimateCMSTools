{% block element_manufacturer_grid %}
    {% set config = element.fieldConfig.elements %}
    {% set manufacturers = element.data.manufacturers %}
    {% set displayLogo = config.displayLogo.value is not null ? config.displayLogo.value : true %}
    {% set displayTitle = config.displayTitle.value is not null ? config.displayTitle.value : true %}
    {% set displayDescription = config.displayDescription.value is not null ? config.displayDescription.value : true %}
    {% set columnsMobile = config.columnsMobile.value ?? '1' %}

    {% if manufacturers and manufacturers.count > 0 %}
        <div class="cms-element-manufacturer-grid">
            <div class="manufacturer-grid-container columns-mobile-{{ columnsMobile }}">
                {% for manufacturer in manufacturers %}
                    {% set manufacturerUrl = manufacturer.link %}
                    {% set extStruct = manufacturer.extension('ultimateCmsTools') %}
                    {% set isExternal = extStruct ? extStruct.isExternal : false %}
                    {% set media = manufacturer.media %}
                    
                    {% if manufacturerUrl %}
                        <a href="{{ manufacturerUrl }}" class="manufacturer-card" title="{{ manufacturer.translated.name }}" {% if isExternal %}target="_blank" rel="noopener"{% else %}target="_self"{% endif %}>
                            {% if displayLogo %}
                                <div class="manufacturer-card-image-wrapper">
                                    {% if media %}
                                        {% set attributes = {
                                            'class': 'manufacturer-card-logo',
                                            'alt': (media.translated.alt ?: manufacturer.translated.name),
                                            'title': (media.translated.title ?: manufacturer.translated.name),
                                            'loading': 'lazy'
                                        } %}
                                        {% sw_thumbnails 'manufacturer-card-thumbnails' with {
                                            media: media,
                                            attributes: attributes
                                        } %}
                                    {% else %}
                                        <div class="manufacturer-card-image-placeholder">
                                            <span class="manufacturer-card-placeholder-text">{{ manufacturer.translated.name }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if displayTitle or displayDescription %}
                                <div class="manufacturer-card-content">
                                    {% if displayTitle %}
                                        <h3 class="manufacturer-card-title">{{ manufacturer.translated.name }}</h3>
                                    {% endif %}
                                    {% if displayDescription and manufacturer.translated.description %}
                                        <div class="manufacturer-card-description">
                                            {{ manufacturer.translated.description|striptags|u.truncate(80, '...', false) }}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </a>
                    {% else %}
                        <div class="manufacturer-card" title="{{ manufacturer.translated.name }}">
                            {% if displayLogo %}
                                <div class="manufacturer-card-image-wrapper">
                                    {% if media %}
                                        {% set attributes = {
                                            'class': 'manufacturer-card-logo',
                                            'alt': (media.translated.alt ?: manufacturer.translated.name),
                                            'title': (media.translated.title ?: manufacturer.translated.name),
                                            'loading': 'lazy'
                                        } %}
                                        {% sw_thumbnails 'manufacturer-card-thumbnails' with {
                                            media: media,
                                            attributes: attributes
                                        } %}
                                    {% else %}
                                        <div class="manufacturer-card-image-placeholder">
                                            <span class="manufacturer-card-placeholder-text">{{ manufacturer.translated.name }}</span>
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            {% if displayTitle or displayDescription %}
                                <div class="manufacturer-card-content">
                                    {% if displayTitle %}
                                        <h3 class="manufacturer-card-title">{{ manufacturer.translated.name }}</h3>
                                    {% endif %}
                                    {% if displayDescription and manufacturer.translated.description %}
                                        <div class="manufacturer-card-description">
                                            {{ manufacturer.translated.description|striptags|u.truncate(80, '...', false) }}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
