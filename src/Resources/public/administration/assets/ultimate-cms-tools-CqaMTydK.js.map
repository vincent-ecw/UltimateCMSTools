<div class="sw-cms-el-config-manufacturer-carousel">
    <sw-tabs default-item="content">
        <template #default="{ active }">
            <sw-tabs-item name="content" :active-tab="active">{{ $t('sw-cms.elements.ultimateCmsTools.introOutro.content') }}</sw-tabs-item>
            <sw-tabs-item name="intro-outro" :active-tab="active">{{ $t('sw-cms.elements.ultimateCmsTools.introOutro.tab') }}</sw-tabs-item>
        </template>
        <template #content="{ active }">
            <div v-if="active === 'content'">
    <sw-number-field
                    v-model="descriptionLines"
                    :label="$tc('sw-cms.elements.ultimateCmsTools.descriptionLines.label')"
                    :helpText="$tc('sw-cms.elements.ultimateCmsTools.descriptionLines.help')"
                    :min="1" :max="20" :step="1">
                </sw-number-field>
                <sw-single-select v-model:value="theme"
        :label="$tc('sw-cms.elements.ultimateCmsTools.subcategoryThemes.label')"
        :helpText="$tc('sw-cms.elements.ultimateCmsTools.subcategoryThemes.help')"
        :options="themeOptions">
    </sw-single-select>
    <sw-alert variant="info">
        {{ $tc('sw-cms.elements.ultimateCmsTools.manufacturerCarousel.configInfo') }}
    </sw-alert>

    <div class="sw-cms-el-config-manufacturer-carousel__settings" style="margin-top: 15px;">
        <sw-single-select
            v-model:value="sortBy"
            :label="$tc('sw-cms.elements.ultimateCmsTools.manufacturerSorting.sortBy')"
            :options="sortByOptions">
        </sw-single-select>

        <sw-single-select
            v-model:value="sorting"
            :label="$tc('sw-cms.elements.ultimateCmsTools.manufacturerSorting.label')"
            :helpText="$tc('sw-cms.elements.ultimateCmsTools.manufacturerSorting.help')"
            :options="sortingOptions">
        </sw-single-select>

        <sw-switch-field
            v-model:value="displayLogo"
            :label="$tc('sw-cms.elements.ultimateCmsTools.manufacturerCarousel.config.displayLogoLabel')">
        </sw-switch-field>

        <sw-switch-field
            v-model:value="displayTitle"
            :label="$tc('sw-cms.elements.ultimateCmsTools.manufacturerCarousel.config.displayTitleLabel')">
        </sw-switch-field>

        <sw-switch-field
            v-model:value="displayDescription"
            :label="$tc('sw-cms.elements.ultimateCmsTools.manufacturerCarousel.config.displayDescriptionLabel')">
        </sw-switch-field>

        <sw-switch-field
            v-model:value="element.config.navigationArrows.value"
            :label="$tc('sw-cms.elements.customProductCarousel.config.navigationArrows')"
            @change="onChange">
        </sw-switch-field>

        <sw-switch-field
            v-model:value="element.config.navigationDots.value"
            :label="$tc('sw-cms.elements.customProductCarousel.config.navigationDots')"
            @change="onChange">
        </sw-switch-field>

        <sw-single-select
            v-if="element.config.navigationDots.value"
            v-model:value="element.config.navigationDotsPosition.value"
            :label="$tc('sw-cms.elements.customProductCarousel.config.navigationDotsPosition')"
            :options="dotsPositionOptions"
            @change="onChange">
        </sw-single-select>

        <sw-switch-field
            v-model:value="element.config.autoplay.value"
            :label="$tc('sw-cms.elements.customProductCarousel.config.autoplay')"
            @change="onChange">
        </sw-switch-field>

        <sw-number-field
            v-if="element.config.autoplay.value"
            v-model:value="element.config.autoplaySpeed.value"
            :label="$tc('sw-cms.elements.customProductCarousel.config.autoplaySpeed')"
            :helpText="$tc('sw-cms.elements.customProductCarousel.config.autoplaySpeedHelp')"
            :min="0"
            @change="onChange">
        </sw-number-field>

        <sw-number-field
            v-model:value="element.config.maxHeight.value"
            :label="$tc('sw-cms.elements.customProductCarousel.config.maxHeight')"
            :helpText="$tc('sw-cms.elements.customProductCarousel.config.maxHeightHelp')"
            :min="0"
            @change="onChange">
        </sw-number-field>
    </div>

            </div>
            <div v-if="active === 'intro-outro'"><uct-cms-intro-outro v-model:intro="uctIntroText" v-model:outro="uctOutroText" /></div>
        </template>
    </sw-tabs>
</div>
