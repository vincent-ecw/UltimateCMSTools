{% block block_flexible_image_text %}
    <div class="cms-block-flexible-image-text">
        {% set element = block.slots.getSlot('content') %}

        {% if element %}
            <div data-cms-element-id="{{ element.id }}">
                {% sw_include '@Storefront/storefront/element/cms-element-' ~ element.type ~ '.html.twig' ignore missing with {
                    element: element
                } %}
            </div>
        {% endif %}
    </div>
{% endblock %}
