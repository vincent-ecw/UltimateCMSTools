<div class="sw-cms-el-config-flexible-image-text">
    <sw-tabs default-item="content" position="top">
        <template #default="{ active }">
            <sw-tabs-item name="content" :active-tab="active" @click="activeTab = 'content'">
                {{ $tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.tabs.content') }}
            </sw-tabs-item>
            <sw-tabs-item name="settings" :active-tab="active" @click="activeTab = 'settings'">
                {{ $tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.tabs.settings') }}
            </sw-tabs-item>
        </template>
    </sw-tabs>

    <div v-if="activeTab === 'content'" class="sw-cms-el-config-flexible-image-text__content-tab">
        <!-- Media Upload -->
        <div class="sw-cms-el-config-flexible-image-text__media-upload">
            <sw-media-compact-upload-v2
                :source="media"
                :upload-tag="'flexible-image-text-media-' + element.id"
                :allowMultiSelect="false"
                :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.mediaLabel')"
                @selection-change="onImageSelect"
                @media-upload-remove-image="onImageRemove">
            </sw-media-compact-upload-v2>
            <sw-upload-listener
                :upload-tag="'flexible-image-text-media-' + element.id"
                auto-upload
                @media-upload-finish="onImageUpload">
            </sw-upload-listener>
        </div>

        <!-- Polaroid / Image Caption -->
        <sw-text-field
            v-model="caption"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.captionLabel')"
            :placeholder="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.captionPlaceholder')"
            :help-text="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.captionHelp')">
        </sw-text-field>

        <!-- Rich Text Editor for Content -->
        <sw-text-editor
            :value="content"
            @update:value="onContentChange"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.contentLabel')"
            :placeholder="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.contentPlaceholder')">
        </sw-text-editor>
    </div>

    <div v-if="activeTab === 'settings'" class="sw-cms-el-config-flexible-image-text__settings-tab">
        <!-- Position -->
        <sw-single-select
            v-model:value="position"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.positionLabel')"
            :options="positionOptions">
        </sw-single-select>

        <!-- Column Size -->
        <sw-single-select
            v-model:value="columnSize"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.columnSizeLabel')"
            :options="columnSizeOptions">
        </sw-single-select>

        <!-- Entrance Animation -->
        <sw-single-select
            v-model:value="animation"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.animationLabel')"
            :options="animationOptions">
        </sw-single-select>

        <!-- Theme -->
        <sw-single-select
            v-model:value="theme"
            :label="$tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.themeLabel')"
            :options="themeOptions">
        </sw-single-select>
    </div>
</div>
