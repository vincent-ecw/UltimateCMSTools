<div :class="elementClasses">
    <div class="flexible-image-text__container">
        <!-- Image Column -->
        <div class="flexible-image-text__image-wrapper">
            <div v-if="theme === 'polaroid'" class="flexible-image-text__polaroid-card">
                <div class="flexible-image-text__media-box">
                    <img v-if="mediaUrl" :src="mediaUrl" alt="Media preview" class="flexible-image-text__image" />
                    <div v-else class="flexible-image-text__placeholder">
                        <sw-icon name="regular-image" size="48px"></sw-icon>
                    </div>
                </div>
                <div v-if="caption" class="flexible-image-text__caption">
                    {{ caption }}
                </div>
            </div>

            <div v-else class="flexible-image-text__media-box">
                <img v-if="mediaUrl" :src="mediaUrl" alt="Media preview" class="flexible-image-text__image" />
                <div v-else class="flexible-image-text__placeholder">
                    <sw-icon name="regular-image" size="48px"></sw-icon>
                </div>
                <div v-if="caption" class="flexible-image-text__caption">
                    {{ caption }}
                </div>
            </div>
        </div>

        <!-- Text Column -->
        <div class="flexible-image-text__text-wrapper">
            <div class="flexible-image-text__text-content" v-html="$sanitize(content)"></div>
        </div>
    </div>
    <div v-if="hasReadMore" class="uct-read-more" :class="{ 'is-expanded': readMoreExpanded }" :style="readMoreStyle">
        <div :id="'uct-read-more-preview-' + element.id" class="uct-read-more__panel" :aria-hidden="!readMoreExpanded" :inert="!readMoreExpanded">
            <div class="uct-read-more__inner">
                <div class="uct-read-more__content flexible-image-text__text-content" v-html="readMoreText"></div>
            </div>
        </div>
        <div class="uct-read-more__actions">
            <button type="button" class="btn" :class="readMoreButtonClass" :aria-expanded="readMoreExpanded"
                    :aria-controls="'uct-read-more-preview-' + element.id" @click.stop="readMoreExpanded = !readMoreExpanded">
                {{ $tc('sw-cms.elements.ultimateCmsTools.flexibleImageText.config.' + (readMoreExpanded ? 'readLess' : 'readMore')) }}
            </button>
        </div>
    </div>
</div>
