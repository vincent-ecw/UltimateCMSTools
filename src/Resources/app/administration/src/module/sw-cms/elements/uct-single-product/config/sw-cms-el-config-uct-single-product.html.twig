<div class="sw-cms-el-config-uct-single-product">
    <sw-tabs default-item="content">
        <template #default="{ active }">
            <sw-tabs-item name="content" :active-tab="active">{{ $t('sw-cms.elements.ultimateCmsTools.introOutro.content') }}</sw-tabs-item>
            <sw-tabs-item name="intro-outro" :active-tab="active">{{ $t('sw-cms.elements.ultimateCmsTools.introOutro.tab') }}</sw-tabs-item>
        </template>
        <template #content="{ active }">
            <div v-if="active === 'content'">
    <sw-entity-single-select
        v-model:value="productId"
        entity="product"
        :criteria="productCriteria"
        :context="productContext"
        :label="$tc('sw-cms.elements.ultimateCmsTools.singleProduct.product')"
        :placeholder="$tc('sw-cms.elements.ultimateCmsTools.singleProduct.search')"
        show-clearable-button>
        <template #selection-label-property="{ item }">
            <sw-product-variant-info :variations="item.variation">{{ item.translated.name || item.name }} — {{ item.productNumber }}</sw-product-variant-info>
        </template>
        <template #result-item="{ item, index }">
            <sw-select-result :item="item" :index="index">
                <sw-product-variant-info :variations="item.variation">{{ item.translated.name || item.name }} — {{ item.productNumber }}</sw-product-variant-info>
            </sw-select-result>
        </template>
    </sw-entity-single-select>
    <mt-switch v-model="showVariants" :label="$tc('sw-cms.elements.ultimateCmsTools.singleProduct.showVariants')" />
    <sw-text-field v-model="badge1Text" :label="$tc('sw-cms.elements.ultimateCmsTools.singleProduct.badge1Text')" />
    <sw-single-select v-model:value="badge1Color" :options="badgeColorOptions" :label="$tc('sw-cms.elements.ultimateCmsTools.singleProduct.badge1Color')" />
    <mt-switch v-model="badge1DarkText" :label="$tc('sw-cms.elements.ultimateCmsTools.singleProduct.showDarkText')" />
    <sw-text-field v-model="badge2Text" :label="$tc('sw-cms.elements.ultimateCmsTools.singleProduct.badge2Text')" />
    <sw-single-select v-model:value="badge2Color" :options="badgeColorOptions" :label="$tc('sw-cms.elements.ultimateCmsTools.singleProduct.badge2Color')" />
    <mt-switch v-model="badge2DarkText" :label="$tc('sw-cms.elements.ultimateCmsTools.singleProduct.showDarkText')" />

            </div>
            <div v-if="active === 'intro-outro'"><uct-cms-intro-outro v-model:intro="uctIntroText" v-model:outro="uctOutroText" /></div>
        </template>
    </sw-tabs>
</div>
