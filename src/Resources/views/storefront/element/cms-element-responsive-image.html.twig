{% block element_responsive_image %}
    {% if element.config.uctIntroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'intro' } %}
    {% endif %}
	{% set config = element.fieldConfig.elements %}
	{% set mediaDesktop = element.data ? element.data.get('mediaDesktop') : null %}
	{% set mediaTablet = element.data ? element.data.get('mediaTablet') : null %}
	{% set mediaMobile = element.data ? element.data.get('mediaMobile') : null %}

	{% set altText = config.altText.value|default('') %}
	{% set linkUrl = config.linkUrl.value|default('')|uct_safe_url %}
	{% set linkTarget = config.linkTarget.value|default('_self') == '_blank' ? '_blank' : '_self' %}

	{% set maxWidth = config.maxWidth.value|default(0)|uct_bounded_int(0, 10000, 0) %}
	{% set maxHeight = config.maxHeight.value|default(0)|uct_bounded_int(0, 10000, 0) %}

	<div class="cms-element-responsive-image"{% if maxWidth or maxHeight %} style="{% if maxWidth %}--uct-responsive-image-max-width: {{ maxWidth }}px;{% endif %}{% if maxHeight %}--uct-responsive-image-max-height: {{ maxHeight }}px;{% endif %}"{% endif %}>
		{% if mediaDesktop %}
			{% if linkUrl %}
				<a href="{{ linkUrl }}" target="{{ linkTarget }}" {% if linkTarget == '_blank' %}rel="noopener noreferrer"{% endif %} class="responsive-image-link">
				{% endif %}

				<picture class="responsive-image-picture">
					{% if mediaMobile %}
						{% sw_include '@UltimateCmsTools/storefront/utilities/uct-picture-source.html.twig' with { media: mediaMobile, mediaQuery: '(max-width: 576px)', imageSizes: '100vw' } %}
					{% endif %}
					{% if mediaTablet %}
						{% sw_include '@UltimateCmsTools/storefront/utilities/uct-picture-source.html.twig' with { media: mediaTablet, mediaQuery: '(max-width: 767px)', imageSizes: '100vw' } %}
					{% endif %}
					{% sw_thumbnails 'uct-content-image' with { media: mediaDesktop, uctImageProfile: 'content', sizes: {default: '100vw'}, attributes: { alt: altText|default(mediaDesktop.translated.alt|default('')), class: 'responsive-image-img', loading: 'lazy' } } %}
				</picture>

				{% if linkUrl %}
				</a>
			{% endif %}
		{% endif %}
	</div>
    {% if element.config.uctOutroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'outro' } %}
    {% endif %}
{% endblock %}
