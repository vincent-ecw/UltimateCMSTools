{% block element_custom_carousel %}
    {% set config = element.fieldConfig.elements %}
    {% set items = element.data ? element.data.carouselItems : config.carouselItems.value %}
    {% set navigationArrows = config.navigationArrows.value is not null ? config.navigationArrows.value : true %}
    {% set navigationDots = config.navigationDots.value is not null ? config.navigationDots.value : true %}
    {% set autoplay = config.autoplay.value is not null ? config.autoplay.value : true %}
    {% set autoplaySpeed = config.autoplaySpeed.value|default(5000) %}
    {% set dotsPosition = config.navigationDotsPosition.value|default('inside') %}
    {% set maxHeight = config.maxHeight.value|default(null) %}
    {% set theme = config.theme.value|default('classic') %}
    {% set highlightActiveItem = config.highlightActiveItem.value is not null ? config.highlightActiveItem.value : false %}

    {% if items and items|length > 0 %}
        <div class="cms-element-custom-carousel uct-theme-{{ theme }} {% if highlightActiveItem %}uct-highlight-active{% endif %}"
             {% if maxHeight and maxHeight > 0 %}style="--uct-carousel-max-height: {{ maxHeight }}px; max-height: {{ maxHeight }}px;"{% endif %}
             data-custom-carousel="true"
             data-custom-carousel-options='{
                 "arrows": {{ navigationArrows ? "true" : "false" }},
                 "dots": {{ navigationDots ? "true" : "false" }},
                 "autoplay": {{ autoplay ? "true" : "false" }},
                 "autoplaySpeed": {{ autoplaySpeed }},
                 "highlightActiveItem": {{ highlightActiveItem ? "true" : "false" }}
             }'>
            <div class="custom-carousel-wrapper">
                {% if navigationArrows %}
                    <button type="button" class="btn btn-light uct-carousel-control custom-carousel-control prev" aria-label="Previous">
                        {% sw_icon 'arrow-left' %}
                    </button>
                {% endif %}

                <div class="custom-carousel-container">
                    {% for item in items %}
                        {% set media = item.media %}
                        {% set hasLink = item.buttonUrl is not empty %}
                        {% set categoryStyle = item.categoryStyle|default('primary') %}
                        
                        <{% if hasLink %}a href="{{ item.buttonUrl }}" target="{{ item.buttonTarget|default('_self') }}"{% else %}div{% endif %}
                           class="custom-card {% if highlightActiveItem and loop.first %}active{% endif %}">
                            
                            <div class="custom-card-image-wrapper">
                                {% if media %}
                                    {% set attributes = {
                                        'class': 'custom-card-image',
                                        'alt': (media.translated.alt ?: item.title),
                                        'title': (media.translated.title ?: item.title),
                                        'loading': 'lazy'
                                    } %}
                                    {% sw_thumbnails 'custom-card-thumbnails' with {
                                        media: media,
                                        sizes: {
                                            'default': '360px',
                                            'md': '320px',
                                            'sm': '100vw'
                                        },
                                        attributes: attributes
                                    } %}
                                {% else %}
                                    <div class="custom-card-image-placeholder">
                                        {% sw_icon 'image' style { 'size': 'lg' } %}
                                    </div>
                                {% endif %}

                                {% if theme == 'media' %}
                                    <div class="custom-card-media-overlay">
                                        {% if item.category is not empty %}
                                            <span class="custom-card-category custom-card-category--{{ categoryStyle }}">
                                                {{ item.category }}
                                            </span>
                                        {% endif %}
                                        {% if item.title is not empty %}
                                            <h3 class="custom-card-title custom-card-title--overlay">{{ item.title }}</h3>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="custom-card-content">
                                {% if theme != 'media' %}
                                    <div class="custom-card-meta">
                                        {% if item.category is not empty %}
                                            <span class="custom-card-category custom-card-category--{{ categoryStyle }}">
                                                {{ item.category }}
                                            </span>
                                        {% endif %}
                                        {% if item.itemDate is not empty %}
                                            <span class="custom-card-date">
                                                {% if item.itemDate matches '/^\\d{4}-\\d{2}-\\d{2}/' %}
                                                    {{ item.itemDate|date('d-m-Y') }}
                                                {% else %}
                                                    {{ item.itemDate }}
                                                {% endif %}
                                            </span>
                                        {% endif %}
                                    </div>

                                    <h3 class="custom-card-title">{{ item.title }}</h3>
                                {% else %}
                                    {% if item.itemDate is not empty %}
                                        <div class="custom-card-meta">
                                            <span class="custom-card-date">
                                                {% if item.itemDate matches '/^\\d{4}-\\d{2}-\\d{2}/' %}
                                                    {{ item.itemDate|date('d-m-Y') }}
                                                {% else %}
                                                    {{ item.itemDate }}
                                                {% endif %}
                                            </span>
                                        </div>
                                    {% endif %}
                                {% endif %}

                                {% if item.description is not empty %}
                                    <div class="custom-card-description">
                                        {{ item.description|striptags|u.truncate(80, '...', false) }}
                                    </div>
                                {% endif %}
                            </div>
                        </{% if hasLink %}a{% else %}div{% endif %}>
                    {% endfor %}
                </div>

                {% if navigationArrows %}
                    <button type="button" class="btn btn-light uct-carousel-control custom-carousel-control next" aria-label="Next">
                        {% sw_icon 'arrow-right' %}
                    </button>
                {% endif %}
            </div>

            {% if navigationDots %}
                <div class="uct-carousel-indicators custom-carousel-indicators uct-dots-{{ dotsPosition }} dots-{{ dotsPosition }}">
                    {% for i in 0..(items|length - 1) %}
                        <button type="button" class="uct-carousel-dot custom-carousel-dot {% if loop.first %}active{% endif %}" data-index="{{ i }}" aria-label="Slide {{ i + 1 }}"></button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
