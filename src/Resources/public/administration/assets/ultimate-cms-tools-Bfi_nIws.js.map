<div class="sw-cms-el-faq-harmonica">
    <div v-if="element.config.faqs.value && element.config.faqs.value.length > 0" :class="['faq-harmonica-preview', 'theme-' + currentTheme]">
        <div class="faq-item" v-for="(faq, index) in element.config.faqs.value" :key="index">
            <div class="faq-header">
                <span v-if="currentTheme === 'pill-block'" class="faq-pill-badge">
                    <sw-icon name="regular-chevron-down"></sw-icon>
                </span>
                <span v-if="currentTheme === 'editorial-numbered'" class="faq-number">
                    ({{ (index + 1) < 10 ? '0' + (index + 1) : (index + 1) }})
                </span>
                <sw-icon v-if="faq.icon && currentTheme !== 'pill-block'" :name="faq.icon"></sw-icon>
                <span class="faq-title">{{ faq.title }}</span>
                <sw-icon v-if="currentTheme !== 'pill-block'" name="regular-chevron-down" class="faq-toggle-icon"></sw-icon>
            </div>
        </div>
    </div>
    <div v-else class="sw-cms-el-faq-harmonica-empty">
        <sw-icon name="regular-question-circle" />
        <p>{{ $tc('sw-cms.elements.faqHarmonica.emptyState') }}</p>
    </div>
</div>
