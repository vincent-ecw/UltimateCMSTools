        </div>
        <!-- Col 2: Text 1 -->
        <div class="sw-cms-el-image-text-quartet__col sw-cms-el-image-text-quartet__col--text">
            <div v-if="!text1" class="sw-cms-el-image-text-quartet__text-placeholder">
                <p><strong>{{ $tc('sw-cms.elements.ultimateCmsTools.imageTextQuartet.config.tabs.row1') }}</strong> - {{ $tc('sw-cms.elements.faqHarmonica.config.contentPlaceholder') }}</p>
            </div>
            <div v-else class="sw-cms-el-image-text-quartet__text-content" v-html="$sanitize(text1)"></div>
        </div>
    </div>

    <!-- Row 2 -->
    <div :class="['sw-cms-el-image-text-quartet__row', 'sw-cms-el-image-text-quartet__row--ratio-' + ratio2]">
