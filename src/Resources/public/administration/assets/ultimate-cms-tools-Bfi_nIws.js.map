<div class="sw-cms-el-image-text-quartet">
    <!-- Row 1 -->
    <div :class="['sw-cms-el-image-text-quartet__row', 'sw-cms-el-image-text-quartet__row--ratio-' + ratio1]">
        <!-- Col 1: Image 1 -->
        <div class="sw-cms-el-image-text-quartet__col sw-cms-el-image-text-quartet__col--image">
            <div v-if="!media1Url" class="sw-cms-el-image-text-quartet__placeholder">
                <sw-icon name="regular-image" size="32px"></sw-icon>
                <p>{{ $tc('sw-cms.elements.ultimateCmsTools.imageTextQuartet.config.tabs.row1') }} - {{ $tc('sw-cms.elements.ultimateCmsTools.commonSlider.config.selectMedia') }}</p>
            </div>
            <div v-else class="sw-cms-el-image-text-quartet__image-wrapper">
                <img :src="media1Url" :alt="altText1" class="sw-cms-el-image-text-quartet__image" />
