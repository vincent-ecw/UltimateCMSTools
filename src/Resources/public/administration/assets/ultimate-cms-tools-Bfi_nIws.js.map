<div class="sw-cms-el-config-cta">
    <!-- Title -->
    <sw-text-field
        v-model="title"
        :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.titleLabel')"
        :placeholder="$tc('sw-cms.elements.ultimateCmsTools.cta.config.titlePlaceholder')">
    </sw-text-field>

    <!-- Subtitle -->
    <sw-text-field
        v-model="subtitle"
        :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.subtitleLabel')"
        :placeholder="$tc('sw-cms.elements.ultimateCmsTools.cta.config.subtitlePlaceholder')">
    </sw-text-field>

    <!-- Background Image -->
    <div class="sw-cms-el-config-cta__media-upload">
        <sw-media-compact-upload-v2
            :source="backgroundImage"
            :upload-tag="'cta-background-' + element.id"
            :allowMultiSelect="false"
            :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.backgroundImageLabel')"
            @selection-change="onImageSelect"
            @media-upload-remove-image="onImageRemove">
        </sw-media-compact-upload-v2>
        <sw-upload-listener
            :upload-tag="'cta-background-' + element.id"
            auto-upload
            @media-upload-finish="onImageUpload">
        </sw-upload-listener>
    </div>

    <!-- Min Height -->
    <sw-text-field
        v-model="minHeight"
        :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.minHeightLabel')"
        :placeholder="$tc('sw-cms.elements.ultimateCmsTools.cta.config.minHeightPlaceholder')"
        :help-text="$tc('sw-cms.elements.ultimateCmsTools.cta.config.minHeightHelp')">
    </sw-text-field>

    <!-- Style Selector -->
    <sw-single-select
        v-model:value="style"
        :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.styleLabel')"
        :options="styleOptions">
    </sw-single-select>

    <!-- Layout Structure Selector -->
    <sw-single-select
        v-model:value="layout"
        :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.layoutLabel')"
        :options="layoutOptions">
    </sw-single-select>

    <!-- Text Style Selector -->
    <sw-single-select
        v-model:value="textColor"
        :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.textColorLabel')"
        :options="textColorOptions">
    </sw-single-select>

    <!-- Primary Button -->
    <div class="sw-cms-el-config-cta__section">
        <h4 class="sw-cms-el-config-cta__section-title">{{ $tc('sw-cms.elements.ultimateCmsTools.cta.config.primaryButtonSection') }}</h4>
        <div class="sw-cms-el-config-cta__section-content">
            <sw-text-field
                v-model="buttonText"
                :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonTextLabel')"
                :placeholder="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonTextPlaceholder')">
            </sw-text-field>
            <sw-text-field
                v-model="buttonUrl"
                :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonUrlLabel')"
                :placeholder="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonUrlPlaceholder')">
            </sw-text-field>
            <sw-single-select
                v-model:value="buttonTarget"
                :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonTargetLabel')"
                :options="targetOptions">
            </sw-single-select>
            <sw-single-select
                v-model:value="buttonVariant"
                :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonVariantLabel')"
                :options="buttonVariantOptions">
            </sw-single-select>
        </div>
    </div>

    <!-- Secondary Button -->
    <div class="sw-cms-el-config-cta__section">
        <h4 class="sw-cms-el-config-cta__section-title">{{ $tc('sw-cms.elements.ultimateCmsTools.cta.config.secondaryButtonSection') }}</h4>
        <div class="sw-cms-el-config-cta__section-content">
            <sw-text-field
                v-model="buttonSecondaryText"
                :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonTextLabel')"
                :placeholder="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonTextPlaceholder')">
            </sw-text-field>
            <sw-text-field
                v-model="buttonSecondaryUrl"
                :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonUrlLabel')"
                :placeholder="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonUrlPlaceholder')">
            </sw-text-field>
            <sw-single-select
                v-model:value="buttonSecondaryTarget"
                :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonTargetLabel')"
                :options="targetOptions">
            </sw-single-select>
            <sw-single-select
                v-model:value="buttonSecondaryVariant"
                :label="$tc('sw-cms.elements.ultimateCmsTools.cta.config.buttonVariantLabel')"
                :options="buttonVariantOptions">
            </sw-single-select>
        </div>
    </div>
</div>
