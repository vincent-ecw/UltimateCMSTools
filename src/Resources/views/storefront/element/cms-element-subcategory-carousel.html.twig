{% block element_subcategory_carousel %}
    {% set config = element.fieldConfig.elements %}
    {% set categories = element.data.categories %}
    {% set displayImage = config.displayImage.value ?? true %}
    {% set navigationArrows = config.navigationArrows.value is not null ? config.navigationArrows.value : true %}
    {% set navigationDots = config.navigationDots.value is not null ? config.navigationDots.value : true %}
    {% set autoplay = config.autoplay.value is not null ? config.autoplay.value : true %}
    {% set autoplaySpeed = config.autoplaySpeed.value|default(5000) %}
    {% set dotsPosition = config.navigationDotsPosition.value|default('inside') %}
    {% set maxHeight = config.maxHeight.value|default(null) %}

    {% if categories and categories.count > 0 %}
        <div class="cms-element-subcategory-carousel"
             {% if maxHeight and maxHeight > 0 %}style="--uct-carousel-max-height: {{ maxHeight }}px; max-height: {{ maxHeight }}px;"{% endif %}
             data-subcategory-carousel="true"
             data-subcategory-carousel-options='{
                 "arrows": {{ navigationArrows ? "true" : "false" }},
                 "dots": {{ navigationDots ? "true" : "false" }},
                 "autoplay": {{ autoplay ? "true" : "false" }},
                 "autoplaySpeed": {{ autoplaySpeed }}
             }'>
            <div class="subcategory-carousel-wrapper">
                {% if navigationArrows %}
                    <button type="button" class="btn btn-light uct-carousel-control subcategory-carousel-control prev" aria-label="Previous">
                        {% sw_icon 'arrow-left' %}
                    </button>
                {% endif %}

                <div class="subcategory-carousel-container" {% if maxHeight and maxHeight > 0 %}style="max-height: {{ maxHeight }}px;"{% endif %}>
                    {% for category in categories %}
                        {% set categoryUrl = seoUrl('frontend.navigation.page', { navigationId: category.id }) %}
                        {% set media = category.media %}
                        
                        <a href="{{ categoryUrl }}" class="subcategory-card" title="{{ category.translated.name }}">
                            {% if displayImage %}
                                <div class="subcategory-card-image-wrapper">
                                    {% if media %}
                                        {% set attributes = {
                                            'class': 'subcategory-card-image',
                                            'alt': (media.translated.alt ?: category.translated.name),
                                            'title': (media.translated.title ?: category.translated.name),
                                            'loading': 'lazy'
                                        } %}
                                        {% sw_thumbnails 'subcategory-card-thumbnails' with {
                                            media: media,
                                            attributes: attributes
                                        } %}
                                    {% else %}
                                        <div class="subcategory-card-image-placeholder">
                                            {% sw_icon 'image' style { 'size': 'lg' } %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}

                            <div class="subcategory-card-content">
                                <h3 class="subcategory-card-title">{{ category.translated.name }}</h3>
                                {% if category.translated.description %}
                                    <div class="subcategory-card-description">
                                        {{ category.translated.description|striptags|u.truncate(80, '...', false) }}
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                    {% endfor %}
                </div>

                {% if navigationArrows %}
                    <button type="button" class="btn btn-light uct-carousel-control subcategory-carousel-control next" aria-label="Next">
                        {% sw_icon 'arrow-right' %}
                    </button>
                {% endif %}
            </div>

            {% if navigationDots %}
                <div class="uct-carousel-indicators subcategory-carousel-indicators uct-dots-{{ dotsPosition }} dots-{{ dotsPosition }}">
                    {% for i in 0..(categories.count - 1) %}
                        <button type="button" class="uct-carousel-dot subcategory-carousel-dot {% if loop.first %}active{% endif %}" data-index="{{ i }}" aria-label="Slide {{ i + 1 }}"></button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
