{% sw_extends '@Storefront/storefront/component/product/card/action.html.twig' %}

{% block component_product_box_action_buttons %}
    {% if not uctSingleProduct|default(false) %}
        {{ parent() }}
    {% elseif product.available and product.childCount <= 0 and product.calculatedMaxPurchase >= product.minPurchase %}
        {{ block('component_product_box_action_buy') }}
    {% else %}
        {{ block('component_product_box_action_detail') }}
    {% endif %}
{% endblock %}

{% block component_product_box_action_buy_button %}
    {% if uctSingleProduct|default(false) %}
    {# A selected variant is already concrete; listing themes may otherwise link to Details. #}
    <div class="d-grid">
        <button type="submit" class="btn btn-primary btn-buy">
            {{ 'listing.boxAddProduct'|trans|sw_sanitize }}
        </button>
    </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
