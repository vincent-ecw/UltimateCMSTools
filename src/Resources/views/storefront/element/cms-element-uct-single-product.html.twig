{% block element_uct_single_product %}
    {% if element.data.product %}
        <div class="cms-element-uct-single-product" data-uct-single-product
             data-uct-single-product-options="{{ {
                 url: path('frontend.uct.single_product', {productId: element.data.product.id}),
                 slotId: element.id,
                 errorMessage: 'ultimateCmsTools.singleProduct.error'|trans|striptags
             }|json_encode|e('html_attr') }}">
            <div class="uct-single-product-badges">
                {% for index in [1, 2] %}
                    {% set text = element.config['badge' ~ index ~ 'Text'].value|default('')|trim %}
                    {% set color = element.config['badge' ~ index ~ 'Color'].value|default('primary') %}
                    {% if text is not empty %}
                        {% set color = color in ['primary', 'secondary', 'tertiary'] ? color : 'primary' %}
                        <span class="uct-single-product-badge uct-single-product-badge--{{ color }}{% if element.config['badge' ~ index ~ 'DarkText'].value|default(false) %} uct-single-product-badge--dark-text{% endif %}">{{ text }}</span>
                    {% endif %}
                {% endfor %}
            </div>
            <div data-single-product-card>
                {% sw_include '@UltimateCmsTools/storefront/component/uct-single-product/card.html.twig' with {
                    product: element.data.product,
                    configurator: element.data.configurator,
                    showVariants: element.data.showVariants,
                    requiresSelection: element.data.requiresSelection,
                    slotId: element.id,
                    layout: 'standard',
                    displayMode: 'contain'
                } %}
            </div>
            <p class="uct-single-product-error" role="status" aria-live="polite" data-single-product-error hidden></p>
        </div>
    {% endif %}
{% endblock %}
