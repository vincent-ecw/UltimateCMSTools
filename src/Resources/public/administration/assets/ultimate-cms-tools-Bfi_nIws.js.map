        </div>
        <!-- Col 2: Image 2 -->
        <div class="sw-cms-el-image-text-quartet__col sw-cms-el-image-text-quartet__col--image">
            <div v-if="!media2Url" class="sw-cms-el-image-text-quartet__placeholder">
