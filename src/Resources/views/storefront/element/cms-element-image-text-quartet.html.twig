{% block element_image_text_quartet %}
    {% if element.config.uctIntroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'intro' } %}
    {% endif %}
    {% set config = element.fieldConfig.elements %}
    {% set media1Desktop = element.data ? element.data.get('media1Desktop') : null %}
    {% set media1Tablet = element.data ? element.data.get('media1Tablet') : null %}
    {% set media1Mobile = element.data ? element.data.get('media1Mobile') : null %}

    {% set media2Desktop = element.data ? element.data.get('media2Desktop') : null %}
    {% set media2Tablet = element.data ? element.data.get('media2Tablet') : null %}
    {% set media2Mobile = element.data ? element.data.get('media2Mobile') : null %}

    {% set altText1 = config.altText1.value|default('') %}
    {% set altText2 = config.altText2.value|default('') %}
    {% set text1 = config.text1.value|default('') %}
    {% set text2 = config.text2.value|default('') %}

    {% set ratio1 = config.ratio1.value|default('50-50') %}
    {% set ratio2 = config.ratio2.value|default('50-50') %}

    <div class="cms-element-image-text-quartet">
        <!-- Row 1 -->
        <div class="image-text-quartet__row image-text-quartet__row--1 image-text-quartet__row--ratio-{{ ratio1 }}">
            <!-- Row 1 Column 1: Image -->
            <div class="image-text-quartet__col image-text-quartet__col--image">
                {% if media1Desktop %}
                    <picture class="image-text-quartet__picture">
                        {% if media1Mobile %}
                            {% sw_include '@UltimateCmsTools/storefront/utilities/uct-picture-source.html.twig' with { media: media1Mobile, mediaQuery: '(max-width: 576px)', imageSizes: '100vw' } %}
                        {% endif %}
                        {% if media1Tablet %}
                            {% sw_include '@UltimateCmsTools/storefront/utilities/uct-picture-source.html.twig' with { media: media1Tablet, mediaQuery: '(max-width: 767px)', imageSizes: '100vw' } %}
                        {% endif %}
                        {% sw_thumbnails 'uct-content-image' with { media: media1Desktop, uctImageProfile: 'content', sizes: {default: '100vw'}, attributes: { alt: altText1|default(media1Desktop.translated.alt|default('')), class: 'image-text-quartet__img', loading: 'lazy' } } %}
                    </picture>
                {% endif %}
            </div>

            <!-- Row 1 Column 2: Text -->
            <div class="image-text-quartet__col image-text-quartet__col--text">
                {% if text1 %}
                    <div class="image-text-quartet__text">
                        {{ text1|sw_sanitize }}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Row 2 -->
        <div class="image-text-quartet__row image-text-quartet__row--2 image-text-quartet__row--ratio-{{ ratio2 }}">
            <!-- Row 2 Column 1: Text -->
            <div class="image-text-quartet__col image-text-quartet__col--text">
                {% if text2 %}
                    <div class="image-text-quartet__text">
                        {{ text2|sw_sanitize }}
                    </div>
                {% endif %}
            </div>

            <!-- Row 2 Column 2: Image -->
            <div class="image-text-quartet__col image-text-quartet__col--image">
                {% if media2Desktop %}
                    <picture class="image-text-quartet__picture">
                        {% if media2Mobile %}
                            {% sw_include '@UltimateCmsTools/storefront/utilities/uct-picture-source.html.twig' with { media: media2Mobile, mediaQuery: '(max-width: 576px)', imageSizes: '100vw' } %}
                        {% endif %}
                        {% if media2Tablet %}
                            {% sw_include '@UltimateCmsTools/storefront/utilities/uct-picture-source.html.twig' with { media: media2Tablet, mediaQuery: '(max-width: 767px)', imageSizes: '100vw' } %}
                        {% endif %}
                        {% sw_thumbnails 'uct-content-image' with { media: media2Desktop, uctImageProfile: 'content', sizes: {default: '100vw'}, attributes: { alt: altText2|default(media2Desktop.translated.alt|default('')), class: 'image-text-quartet__img', loading: 'lazy' } } %}
                    </picture>
                {% endif %}
            </div>
        </div>
    </div>
    {% if element.config.uctOutroText.value|default('') %}
        {% include '@UltimateCmsTools/storefront/utilities/uct-surrounding-text.html.twig' with { position: 'outro' } %}
    {% endif %}
{% endblock %}
