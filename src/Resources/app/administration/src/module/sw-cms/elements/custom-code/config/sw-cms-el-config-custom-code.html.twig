<div class="sw-cms-el-config-custom-code">
    <sw-tabs default-item="content">
        <template #default="{ active }">
            <sw-tabs-item name="content" :active-tab="active">{{ $t('sw-cms.elements.ultimateCmsTools.introOutro.content') }}</sw-tabs-item>
            <sw-tabs-item name="intro-outro" :active-tab="active">{{ $t('sw-cms.elements.ultimateCmsTools.introOutro.tab') }}</sw-tabs-item>
        </template>
        <template #content="{ active }">
            <div v-if="active === 'content'">
    <div class="sw-cms-el-config-custom-code__css">
        <sw-code-editor
            v-model:value="cssCode"
            :label="$tc('sw-cms.elements.ultimateCmsTools.customCode.config.cssCodeLabel')"
            language="css"
            editor-height="300"
            :sanitize-input="false">
        </sw-code-editor>
    </div>
    <div class="sw-cms-el-config-custom-code__js" style="margin-top: 20px;">
        <sw-code-editor
            v-model:value="jsCode"
            :label="$tc('sw-cms.elements.ultimateCmsTools.customCode.config.jsCodeLabel')"
            language="javascript"
            editor-height="300"
            :sanitize-input="false">
        </sw-code-editor>
    </div>

            </div>
            <div v-if="active === 'intro-outro'"><uct-cms-intro-outro v-model:intro="uctIntroText" v-model:outro="uctOutroText" /></div>
        </template>
    </sw-tabs>
</div>
