<div class="sw-cms-el-config-custom-code">
    <sw-container title="CSS Code">
        <sw-code-editor
            v-model:value="cssCode"
            language="css"
            editorHeight="300" 
            :sanitizeInput="false">
        </sw-code-editor>
    </sw-container>
    <sw-container title="JavaScript Code" style="margin-top: 20px;">
        <sw-code-editor
            v-model:value="jsCode"
            language="javascript"
            editorHeight="300"
            :sanitizeInput="false">
        </sw-code-editor>
    </sw-container>
</div>
